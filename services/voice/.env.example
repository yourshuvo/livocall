# LivoCall voice engine environment
# Copy into Coolify voice app environment, not into Git.

# Runtime data. Use the same MongoDB database as the web app.
MONGODB_URI=mongodb://USER:PASSWORD@mongo-host:27017/livocall?authSource=admin
REDIS_URL=redis://:PASSWORD@redis-host:6379/0

# Voice -> web callbacks.
# WEB_SHARED_SECRET must match VOICE_SHARED_SECRET on the web app.
WEB_BASE_URL=https://app.yourdomain.com
WEB_SHARED_SECRET=replace-with-shared-web-voice-secret

# Web -> voice API bearer token.
# Must match VOICE_SERVICE_TOKEN on the web app.
VOICE_SERVICE_TOKEN=replace-with-random-service-token

# Browser test media websocket auth.
VOICE_WS_SHARED_SECRET=replace-with-random-ws-secret
VOICE_WS_AUTH_TTL_SECONDS=3600
BROWSER_WEBRTC_ENABLED=true
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# AI providers. Fill only the providers/tiers you use.
GEMINI_API_KEY=
GOOGLE_API_KEY=
SONIOX_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
XAI_API_KEY=

# Telephony defaults. The embedded PJSIP edge is the only phone-call edge.
TELEPHONY_EDGE=pjsip
DEFAULT_OUTBOUND_CALLER_ID=+880****0000
VOICE_FAKE_DRIVER=false
PJSIP_LOAD_ACCOUNTS_FROM_DB=true
PJSIP_DEFAULT_ACCOUNT_SLUG=sip_custom
PJSIP_SIP_SERVER=
PJSIP_SIP_PORT=5060
PJSIP_USERNAME=
PJSIP_AUTH_USERNAME=
PJSIP_PASSWORD=
PJSIP_REALM=*
PJSIP_LOCAL_SIP_PORT=5070
PJSIP_RTP_PORT_START=20000
PJSIP_RTP_PORT_RANGE=10000
PJSIP_PUBLIC_ADDRESS=
PJSIP_BOUND_ADDRESS=
PJSIP_TRANSPORT=udp
PJSIP_CODECS=PCMU/8000,PCMA/8000

# Audio/realtime defaults.
SAMPLE_RATE_IN=16000
SAMPLE_RATE_OUT=24000
PJSIP_FRAME_MS=20
FIRST_TURN_PROMPT_ENABLED=true
GEMINI_PRECONNECT_ENABLED=true
GEMINI_PRECONNECT_TTL_SECONDS=75
LOW_LATENCY_PCMU_BRIDGE_ENABLED=true
LOW_LATENCY_PCMU_BRIDGE_STRICT=true

# Gemini Live defaults.
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Puck
GEMINI_LIVE_LANGUAGE=bn-BD
GEMINI_LIVE_TEMPERATURE=0.25
GEMINI_LIVE_MAX_TOKENS=512
GEMINI_LIVE_VAD_SILENCE_MS=250
GEMINI_LIVE_VAD_PREFIX_PADDING_MS=100
GEMINI_LIVE_CONTEXT_COMPRESSION_ENABLED=true

# Grok Voice defaults.
GROK_VOICE_MODEL=grok-voice-think-fast-1.0
GROK_VOICE_VOICE=rohan
GROK_VOICE_LANGUAGE=bn
GROK_VOICE_AUDIO_FORMAT=audio/pcm
GROK_VOICE_AUDIO_RATE=16000
GROK_VOICE_VAD_THRESHOLD=0.85
GROK_VOICE_VAD_SILENCE_MS=500
GROK_VOICE_VAD_PREFIX_PADDING_MS=500

# Pipeline/DTMF fallback defaults.
PIPELINE_LLM_MODEL=gemini-2.5-flash-lite
PIPELINE_STT_PROVIDER=soniox
PIPELINE_TTS_PROVIDER=soniox
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
CARTESIA_VOICE_ID=

# Pricing in paisa per minute.
RATE_PAISA_PER_MIN_GEMINI_LIVE=700
RATE_PAISA_PER_MIN_GROK_VOICE=700
RATE_PAISA_PER_MIN_PIPELINE=600
RATE_PAISA_PER_MIN_DTMF=200

# Background workers.
ENABLE_CAMPAIGN_DIALER=true
ENABLE_KB_INGESTOR=true
ENABLE_WEBHOOK_SCHEDULER=true
CAMPAIGN_POLL_INTERVAL_SECONDS=5
KB_POLL_INTERVAL_SECONDS=30

# Recording persistence.
# DigitalOcean Spaces bucket public URL: https://shuvo.sgp1.digitaloceanspaces.com
RECORDINGS_LOCAL_DIR=/tmp/livocall-recordings
S3_RECORDINGS_BUCKET=shuvo
S3_REGION=sgp1
S3_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com
S3_RECORDINGS_PUBLIC_BASE_URL=https://shuvo.sgp1.digitaloceanspaces.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SUMMARIZER_ENABLED=true

# Optional observability.
SENTRY_DSN=
