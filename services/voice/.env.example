# Runtime data
MONGODB_URI=mongodb://localhost:27017/livocall
REDIS_URL=redis://localhost:6379/0

# Web app callback target. WEB_SHARED_SECRET must match VOICE_SHARED_SECRET on the web app.
WEB_BASE_URL=http://localhost:3000
WEB_SHARED_SECRET=

# Web app -> voice API bearer token. Must match VOICE_SERVICE_TOKEN on the web app.
VOICE_SERVICE_TOKEN=

# FreeSWITCH ESL
FS_HOST=127.0.0.1
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon
FS_DEFAULT_GATEWAY=sip_custom

# Public WebSocket URL handed to FreeSWITCH mod_audio_fork.
# Use wss://voice.yourdomain.com/ws/audio in production behind Coolify.
VOICE_WS_PUBLIC_URL=ws://127.0.0.1:8084/ws/audio
VOICE_WS_SHARED_SECRET=
VOICE_WS_AUTH_TTL_SECONDS=3600

# AI providers
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
XAI_API_KEY=

# Telephony defaults
DEFAULT_OUTBOUND_CALLER_ID=+8809610000000
VOICE_FAKE_DRIVER=true

# Audio / realtime defaults
SAMPLE_RATE_IN=16000
SAMPLE_RATE_OUT=24000
FS_PREFERRED_CODEC=PCMU
FS_CODEC_MS=20
LOW_LATENCY_PCMU_BRIDGE_ENABLED=true
LOW_LATENCY_PCMU_BRIDGE_STRICT=true

# Background workers
ENABLE_CAMPAIGN_DIALER=false
ENABLE_KB_INGESTOR=false
ENABLE_WEBHOOK_SCHEDULER=false

# Recording persistence
RECORDINGS_LOCAL_DIR=/tmp/livocall-recordings
S3_RECORDINGS_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SUMMARIZER_ENABLED=true

# Optional observability.
SENTRY_DSN=
