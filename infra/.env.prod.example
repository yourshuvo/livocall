# Copy to infra/.env on the VPS before running docker compose, or copy these
# values into Coolify's Docker Compose environment editor.

NEXT_PUBLIC_APP_URL=https://app.yourdomain.com
VOICE_SERVICE_URL=http://voice:8084
WEB_BASE_URL=http://web:3000
VOICE_WS_PUBLIC_URL=wss://voice.yourdomain.com/ws/audio
VOICE_BROWSER_WEBRTC_URL=https://voice.yourdomain.com/webrtc/browser-offer
VOICE_BROWSER_WEBRTC_PREWARM_URL=https://voice.yourdomain.com/webrtc/browser-prewarm

MONGODB_URI=mongodb://mongo:27017/livocall
REDIS_URL=redis://redis:6379/0

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me

VOICE_SERVICE_TOKEN=replace-with-random-hex
VOICE_SHARED_SECRET=replace-with-random-hex
VOICE_WS_SHARED_SECRET=replace-with-random-hex
SIP_CREDENTIAL_SECRET=replace-with-random-hex
SECRETS_VAULT_KEY=replace-with-random-hex
FREESWITCH_CONFIG_TOKEN=replace-with-random-hex

FS_HOST=host.docker.internal
FS_ESL_PORT=8021
FS_ESL_PASSWORD=replace-with-freeswitch-esl-password
FS_DEFAULT_GATEWAY=sip_custom

GEMINI_API_KEY=
GOOGLE_API_KEY=
SONIOX_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
XAI_API_KEY=

# DigitalOcean Spaces bucket public URL: https://shuvo.sgp1.digitaloceanspaces.com
# Use the regional endpoint for S3 API calls and the bucket URL for public links.
FILE_STORAGE_BUCKET=shuvo
FILE_STORAGE_REGION=sgp1
FILE_STORAGE_ENDPOINT=https://sgp1.digitaloceanspaces.com
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=
FILE_STORAGE_FORCE_PATH_STYLE=false
FILE_STORAGE_PUBLIC_BASE_URL=https://shuvo.sgp1.digitaloceanspaces.com

# Call recordings use the same Spaces bucket. Leave S3_* blank only if the voice
# service should inherit FILE_STORAGE_* values from the shared environment.
S3_RECORDINGS_BUCKET=shuvo
S3_REGION=sgp1
S3_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com
S3_RECORDINGS_PUBLIC_BASE_URL=https://shuvo.sgp1.digitaloceanspaces.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
PAYSTATION_BASE_URL=https://api.paystation.com.bd

SENTRY_DSN=
ENABLE_CAMPAIGN_DIALER=true
ENABLE_KB_INGESTOR=true
ENABLE_WEBHOOK_SCHEDULER=true
VOICE_FAKE_DRIVER=false
