{# Jinja2 template — one rendered file per custom SIP provider goes into FS sip_profiles/external/ #}
<include>
  <gateway name="{{ slug }}">
    <param name="username" value="{{ username }}"/>
    <param name="auth-username" value="{{ auth_username | default(username) }}"/>
    <param name="password" value="{{ password }}"/>
    <param name="realm" value="{{ realm }}"/>
    <param name="proxy" value="{{ proxy }}"/>
    <param name="register-proxy" value="{{ register_proxy | default(proxy) }}"/>
    <param name="register" value="{{ 'true' if register else 'false' }}"/>
    <param name="transport" value="{{ transport | default('udp') }}"/>
    <param name="caller-id-in-from" value="true"/>
    <param name="codec-prefs" value="{{ codecs | default('PCMU@20i') }}"/>
    {% if extra_headers %}
    {% for h in extra_headers %}
    <param name="extension-in-contact" value="{{ h }}"/>
    {% endfor %}
    {% endif %}
  </gateway>
</include>
