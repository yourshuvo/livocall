PORT=8787
LIVOCALL_BASE=https://your-livocall-host
LIVOCALL_KEY=bdv_paste_from_dashboard
LIVOCALL_DEFAULT_AGENT_ID=65a1...
LIVOCALL_DEFAULT_FROM=+8809610000000
SHOPIFY_SECRET=your_shopify_app_secret

# Triggers — comma-separated `topic[:agentIdOverride]`.
LIVOCALL_TRIGGERS=orders/create,orders/paid,orders/fulfilled

# Quiet hours window in local time (LIVOCALL_TZ).
LIVOCALL_QUIET_HOURS=22:00-08:00
LIVOCALL_TZ=Asia/Dhaka
