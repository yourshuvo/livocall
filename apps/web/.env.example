# Mongo
MONGODB_URI=mongodb+srv://shuvo:shuvo@cluster0.nxln5na.mongodb.net/?appName=Cluster0
REDIS_URL=

# Clerk authentication
# Leave both blank for Clerk keyless mode in local development. When you claim
# the temporary Clerk app, paste the permanent keys here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Encrypts SIP trunk passwords stored in Mongo.
SIP_CREDENTIAL_SECRET=replace-me-with-a-different-32-char-random-string
# Encrypts Secrets Vault values for tool/API auth. Defaults to SIP_CREDENTIAL_SECRET in dev.
SECRETS_VAULT_KEY=

# Production object storage for KB uploads. Leave FILE_STORAGE_BUCKET empty to use local dev storage.
FILE_STORAGE_BUCKET=
FILE_STORAGE_REGION=auto
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=
FILE_STORAGE_FORCE_PATH_STYLE=false
FILE_STORAGE_PUBLIC_BASE_URL=

# Optional bearer token for FreeSWITCH config render jobs. Send X-LivoCall-Org-Id too.
FREESWITCH_CONFIG_TOKEN=

# Voice service base URL (internal)
VOICE_SERVICE_URL=http://localhost:8084
# Token the web sends as Authorization: Bearer … to the voice service.
VOICE_SERVICE_TOKEN=

# Shared secret for the voice service → web event ingest + webhook cron tick.
# Must match WEB_SHARED_SECRET on the voice side.
VOICE_SHARED_SECRET=

# Public app URL (for invite links and absolute redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PayStation live checkout. PayStation does not provide a sandbox URL here;
# transactions against https://api.paystation.com.bd are real transactions.
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
