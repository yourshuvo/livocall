# LivoCall web app environment
# Copy into Coolify web app environment, not into Git.

# Runtime
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.yourdomain.com
# Optional aliases used by mailer/invite links.
APP_BASE_URL=https://app.yourdomain.com
NEXT_PUBLIC_APP_BASE_URL=https://app.yourdomain.com

# Data
MONGODB_URI=mongodb://USER:PASSWORD@mongo-host:27017/livocall?authSource=admin
# Optional. If empty, rate limiting uses in-memory per-process storage.
REDIS_URL=

# Clerk authentication - required in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_or_test_replace_me
CLERK_SECRET_KEY=sk_live_or_test_replace_me

# Encryption secrets. Use long random values and keep stable after launch.
SIP_CREDENTIAL_SECRET=replace-with-random-32-byte-secret
SECRETS_VAULT_KEY=replace-with-random-32-byte-secret

# Web -> voice API.
# Must point to the public Coolify voice domain unless both containers share an internal network.
VOICE_SERVICE_URL=https://voice.yourdomain.com
VOICE_SERVICE_TOKEN=replace-with-same-value-as-voice-VOICE_SERVICE_TOKEN
# Browser agent tests connect directly to the voice WebSocket without placing a phone call.
# Must match the voice service values when VOICE_WS_SHARED_SECRET is enabled there.
VOICE_WS_PUBLIC_URL=wss://voice.yourdomain.com/ws/audio
VOICE_BROWSER_WEBRTC_URL=https://voice.yourdomain.com/webrtc/browser-offer
VOICE_WS_SHARED_SECRET=replace-with-same-value-as-voice-VOICE_WS_SHARED_SECRET
VOICE_WS_AUTH_TTL_SECONDS=3600
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Voice -> web callbacks.
# Must match WEB_SHARED_SECRET on the voice service.
VOICE_SHARED_SECRET=replace-with-shared-web-voice-secret

# Optional bearer token for FreeSWITCH config render jobs.
# Send as Authorization: Bearer ... plus X-LivoCall-Org-Id.
FREESWITCH_CONFIG_TOKEN=replace-with-random-token
# Optional instant sync webhook on the VPS. If unset, use the VPS cron sync.
FREESWITCH_SYNC_WEBHOOK_URL=
FREESWITCH_SYNC_WEBHOOK_TOKEN=

# Knowledge upload/object storage.
# Leave FILE_STORAGE_BUCKET empty only for development.
FILE_STORAGE_BUCKET=
FILE_STORAGE_REGION=auto
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=
FILE_STORAGE_FORCE_PATH_STYLE=false
FILE_STORAGE_PUBLIC_BASE_URL=

# Mail delivery webhook. Optional; invite emails are logged if unset.
MAIL_WEBHOOK_URL=

# PayStation live checkout. Transactions against https://api.paystation.com.bd are real.
PAYSTATION_MERCHANT_ID=
PAYSTATION_STORE_ID=
PAYSTATION_PASSWORD=
PAYSTATION_SECRET=
PAYSTATION_BASE_URL=https://api.paystation.com.bd

# Optional AI-assisted dashboard features.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Optional text model used by the dashboard agent LLM test. Falls back to Gemini Flash models.
GEMINI_LLM_TEST_MODEL=gemini-2.5-flash

# Optional observability.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
