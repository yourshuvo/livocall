# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/livocall

# Clerk authentication
# Leave both blank only for Clerk keyless mode in local development. Production must set both keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Encrypts SIP trunk passwords stored in Mongo.
SIP_CREDENTIAL_SECRET=replace-me-with-a-different-32-char-random-string

# Encrypts Secrets Vault values. Defaults to SIP_CREDENTIAL_SECRET in development.
SECRETS_VAULT_KEY=

# Voice service API. Web sends VOICE_SERVICE_TOKEN as Authorization: Bearer ...
VOICE_SERVICE_URL=http://localhost:8084
VOICE_SERVICE_TOKEN=

# Voice service -> web internal callbacks. Must match WEB_SHARED_SECRET on the voice service.
VOICE_SHARED_SECRET=

# Optional bearer token for FreeSWITCH config render jobs. Send X-LivoCall-Org-Id too.
FREESWITCH_CONFIG_TOKEN=

# Production object storage for KB uploads. Leave FILE_STORAGE_BUCKET empty to use local dev storage.
FILE_STORAGE_BUCKET=
FILE_STORAGE_REGION=auto
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=
FILE_STORAGE_FORCE_PATH_STYLE=false
FILE_STORAGE_PUBLIC_BASE_URL=

# PayStation live checkout. Transactions against https://api.paystation.com.bd are real.
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
PAYSTATION_BASE_URL=https://api.paystation.com.bd

# Optional AI-assisted dashboard features.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional observability.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
