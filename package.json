{
  "name": "livocall",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "dev": "pnpm --filter @livocall/web dev",
    "build": "pnpm --filter @livocall/web build",
    "start": "pnpm --filter @livocall/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8"
  }
}
